# Flask
FLASK_APP=app.py
SECRET_KEY=change-me-in-production
FLASK_ENV=development

# SQLite (default path: instance/db.sqlite3)
DATABASE_URL=

# SynCore proxy — required for all /api/syncore/open/* routes
# Send as header: X-Service-Key: <value>  OR  Authorization: Bearer <value>
SYNCORE_SERVICE_KEY=your-long-random-secret

PORT=5000

# SynCore HRMS (JSON object as a single line)
# API_BASE should be https://hrsapi.thesynapses.com (no trailing slash)
SYN_CORE_CONFIG={"HR_CODE":"...","API_BASE":"https://hrsapi.thesynapses.com","DEFAULT_USER_ID":"...","DEFAULT_SIGNED_ARRAY":"...","DATE_FMT":"%m/%d/%Y"}